[Unit]
Description=PixelFrame - Digitaler Bilderrahmen
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pixelframe
Environment=PIXELFRAME_DATA_DIR=/opt/pixelframe/data/images
ExecStart=/opt/pixelframe/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
